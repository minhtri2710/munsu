# Repository-local coordination artifacts produced by agents and validation runs.
/runs/

# Binaries
/bin/munsu
/munsu
# `go build` with no -o inside a .github/scripts tool directory drops a multi-MB
# binary named after the directory. Nothing in CI fails on a committed build
# artifact, so it merges silently unless it is ignored here. gitignore has no way
# to say "a file named after its own directory", so each tool needs its own line.
/.github/scripts/guardsites/guardsites
/.github/scripts/citations/citations
/.github/scripts/testnames/testnames
/.github/scripts/flake-sweep-topology/flake-sweep-topology
*.test
*.test.exe
*.test.exe~
*.out
*.cov

# Scratchpad artifacts produced by local review and agent workflows.
/scratchpad/

# UltraReview artifacts produced by local review tooling.
/docs/ultrareview/

# Task queue artifacts produced by local coordination tooling.
/backlog.md
/done-archive.md

# Backpass artifacts produced by local review tooling.
/.backpass/

# Coverage artifacts produced by CI and local test runs.
/coverage/
/.github/coverage/

/state/
/data/
/config/
/projects/
.no-mistakes/
.env
.DS_Store
__pycache__/
*.pyc

# munsu soldier launch artifacts
.soldier-brief.md
.soldier-launch.sh
.soldier-charter.md
.soldier-envelope.json
.soldier-prompt.md
.soldier-manifest.json
.soldier-md
.herdr-test/
.soldier-md
/.no-mistakes-document-result.json
/.review-result.json
/review_findings.json

# Agent-skill mirror: munsu ships its own skills here (bootstrap-diagnostics,
# captain-provisioning, harness-adapters, munsu-ops, munsu-update,
# stuck-soldier-recovery), each mirrored from the //go:embed source and already
# tracked. A generic engineering-skill library also gets installed here per
# checkout; it is machine-local, not munsu-owned, and must stay out of the repo.
# gitignore never untracks the six, so this ignores every skill subdir and the
# tracked ones stay tracked; a new munsu skill is added with `git add -f`.
/.agents/skills/*/
